{# Form theme of the widgets generated by FormWidgetViewType / FormWidgetListType #}

{% block widget_composed_row %}
    {% if label is same as(false) %}
        {{ form_errors(form) }}
        {{ form_widget(form) }}
    {% else %}
        <fieldset class="widget-composed">
            <legend>{{ label }}</legend>
            {{ form_errors(form) }}
            {{ form_widget(form) }}
        </fieldset>
    {% endif %}
{% endblock %}

{% block widget_list_row %}
    <fieldset class="widget-list">
        {% if label is not same as(false) %}
            <legend>{{ label }}{% if min > 0 %} <small>(au moins une entrée)</small>{% endif %}</legend>
        {% endif %}
        {{ form_errors(form) }}
        {{ form_widget(form) }}
    </fieldset>
{% endblock %}

{# Entries + "+" button; public/js/form-widget-list.js adds and removes entries #}
{% block widget_list_widget %}
    {% set prototype_html %}{% with {entry: prototype} %}{{ block('widget_list_entry') }}{% endwith %}{% endset %}
    <div {{ block('widget_container_attributes') }}
         data-widget-list
         data-min="{{ min }}"
         data-prototype-name="{{ prototype_name }}"
         data-prototype="{{ prototype_html | e('html_attr') }}"
         data-index="{{ form | length > 0 ? max(form | keys) + 1 : 0 }}">
        <div class="widget-list__entries" data-widget-list-entries>
            {% for entry in form %}
                {{ block('widget_list_entry') }}
            {% endfor %}
        </div>
        <button type="button" class="btn widget-list__add" data-widget-list-add title="Ajouter une entrée">+</button>
    </div>
{% endblock %}

{% block widget_list_entry %}
    <div class="widget-list__entry" data-widget-list-entry>
        <div class="widget-list__entry-content">
            {{ form_errors(entry) }}
            {{ form_widget(entry) }}
        </div>
        <button type="button" class="btn btn-danger widget-list__remove" data-widget-list-remove title="Retirer cette entrée">−</button>
    </div>
{% endblock %}
